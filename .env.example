# 서버 전용. 실제 키는 .env.local(권한 600) 또는 Vercel Secret 환경변수에 저장합니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마세요. 이 예제에는 실제 값을 넣지 마세요.
OPENAI_API_KEY=
# 선택: OpenAI 대신 Anthropic API 사용
# ANTHROPIC_API_KEY=

# auto: OpenAI -> Anthropic -> 로컬 개발에서만 Claude Code
EASYAPPLY_PROVIDER=auto
# EASYAPPLY_OPENAI_MODEL=gpt-5.4
# EASYAPPLY_MODEL=claude-opus-5-5
# EASYAPPLY_EFFORT=medium

# 운영 필수: 무작위 32바이트 이상 서버 서명 키 + 공유 Redis REST 저장소
EASYAPPLY_SIGNING_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace Upstash 연결이 주입하는 KV_REST_API_URL / KV_REST_API_TOKEN도 지원합니다.
# UPSTASH_*를 직접 설정하면 해당 URL/토큰 쌍을 우선 사용합니다.
# 자체 호스팅 운영 필수. Vercel에서는 현재 배포 origin도 자동 허용합니다.
# EASYAPPLY_APP_ORIGIN=https://your-domain.example

# 제한된 공개 테스트: 12자 이상 이용 코드(선택). 생략 시 누구나 세션 발급 가능.
# EASYAPPLY_ACCESS_CODE=
# 전체 서비스의 24시간 호출 한도(분석+판정, 실패/취소 포함)와 동시 호출 한도
EASYAPPLY_DAILY_AI_LIMIT=100
EASYAPPLY_MAX_CONCURRENT=3
EASYAPPLY_REQUEST_TIMEOUT_MS=240000

# 로컬 Claude Code 선택 설정. Vercel에서는 항상 비활성화됩니다.
# CLAUDE_BIN=/opt/homebrew/bin/claude
# EASYAPPLY_CLI_MODEL=opus
# 자체 호스팅 로컬 production 모드에서만 CLI를 쓰려면 명시적 설정 필요
# EASYAPPLY_ALLOW_LOCAL_CLI=1
