# ── AI 연결 (셋 중 하나) ──────────────────────────────
# 1) Anthropic API — 배포할 때는 이 방법을 쓰세요.
ANTHROPIC_API_KEY=

# 2) 키가 없고 이 컴퓨터에 Claude Code(claude)가 로그인되어 있으면 자동으로 그걸 씁니다.
# 3) 둘 다 없으면 샘플 공고문 체험만 됩니다.

# 강제로 고르기: auto(기본) | api | cli | demo
# EASYAPPLY_PROVIDER=auto

# 모델 / 추론 강도(low|medium|high|xhigh|max). medium이 속도·품질 균형이 좋아요.
# EASYAPPLY_MODEL=claude-opus-5-5
# EASYAPPLY_EFFORT=medium

# Claude Code 경로·모델을 직접 지정하고 싶을 때
# CLAUDE_BIN=/opt/homebrew/bin/claude
# EASYAPPLY_CLI_MODEL=opus
